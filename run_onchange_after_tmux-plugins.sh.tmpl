{{ if ne .chezmoi.os "windows" -}}
#!/bin/sh
# .tmux.conf hash: {{ includeTemplate "dot_tmux.conf.tmpl" . | sha256sum }}
# Install/clean TPM plugins whenever the plugin list changes
command -v tmux >/dev/null 2>&1 || exit 0
[ -x "$HOME/.tmux/plugins/tpm/bin/install_plugins" ] || exit 0

# TPM names plugin directories after the repo name, so catppuccin/tmux and other
# "*/tmux" themes (e.g. nordtheme/tmux) share ~/.tmux/plugins/tmux. If another theme
# occupies it, TPM treats catppuccin as installed and silently loads the wrong theme.
dir="$HOME/.tmux/plugins/tmux"
if [ -d "$dir" ] && [ ! -f "$dir/catppuccin.tmux" ]; then
  echo "Removing $dir: occupied by a different plugin, not catppuccin" >&2
  rm -rf "$dir"
fi
# TPM never re-checks out an installed plugin, so a checkout of an older pin
# (e.g. the v2.1.3 tag) would stick; reinstall it to follow main.
if [ -d "$dir" ] && [ "$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "main" ]; then
  echo "Reinstalling $dir: catppuccin not on main" >&2
  rm -rf "$dir"
fi

"$HOME/.tmux/plugins/tpm/bin/install_plugins"
"$HOME/.tmux/plugins/tpm/bin/clean_plugins"
{{ end -}}
