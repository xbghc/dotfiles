{{- /* chezmoi:modify-template */ -}}
{{- /*
  Windows-style shortcuts on macOS (Ctrl+C/V/X/Z/..., Home/End, Ctrl+arrows, Alt+Tab, ...) so both OSes share one muscle memory.
  The rules are the vendored rux616/karabiner-windows-mode ruleset (.vendor/karabiner-windows-mode, see README) minus $skip;
  terminals, IDEs (VSCode included), VMs and remote desktops are excepted upstream, so Ctrl keys reach tmux/nvim untouched.
  They are merged into every profile under the "[chezmoi] " description prefix; devices, other rules and everything else
  Karabiner-Elements writes are left as-is on each machine.
*/ -}}
{{- $prefix := "[chezmoi] " -}}
{{- /* The single rule shipped before the ruleset was adopted */ -}}
{{- $legacy := "Ctrl+C copies in GUI apps (terminals and VSCode keep it as interrupt)" -}}
{{- /*
  Skipped: Insert variants superseded by their "[+Terminal Emulators]" twins, Ctrl+Space (stays the input source switch),
  Cmd+1..9 (runs shell commands and shadows browser tab switching), Win alone -> Spotlight, Win+L / Alt+Ctrl+L lock and sleep.
*/ -}}
{{- $skip := `^(Insert \((Ctrl|Shift)\)$|Space \(Ctrl\)$|[1-9] \(Cmd\)|Win |L \((Win|Alt\+Ctrl)\))` -}}
{{- $managed := list -}}
{{- range (include ".vendor/karabiner-windows-mode/windows_shortcuts.json" | fromJson).rules -}}
{{-   if not (regexMatch $skip .description) -}}
{{-     $managed = append $managed (set . "description" (print $prefix .description)) -}}
{{-   end -}}
{{- end -}}
{{- $k := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $k = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- $profiles := get $k "profiles" | default (list (dict "name" "Default profile" "selected" true)) -}}
{{- range $p := $profiles -}}
{{-   $cm := get $p "complex_modifications" | default (dict) -}}
{{-   $rules := $managed -}}
{{-   range (get $cm "rules" | default (list)) -}}
{{-     $d := get . "description" | toString -}}
{{-     if not (or (hasPrefix $prefix $d) (eq $d $legacy)) -}}
{{-       $rules = append $rules . -}}
{{-     end -}}
{{-   end -}}
{{-   $_ := set $cm "rules" $rules -}}
{{-   $_ := set $p "complex_modifications" $cm -}}
{{- end -}}
{{- $k = $k | setValueAtPath "profiles" $profiles -}}
{{- $k | toPrettyJson "  " -}}
