{{ if eq .chezmoi.os "windows" -}}
# 为当前用户安装 JetBrainsMono Nerd Font（无需管理员），已安装则跳过
$ErrorActionPreference = "Stop"
$regKey = "HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts"
$installed = (Get-ItemProperty $regKey -ErrorAction SilentlyContinue).PSObject.Properties.Name -match "^JetBrainsMono NF "
if ($installed) { exit 0 }

$tmp = Join-Path $env:TEMP "JetBrainsMonoNF"
$zip = "$tmp.zip"
Write-Host "Downloading JetBrainsMono Nerd Font..."
Invoke-WebRequest "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip" -OutFile $zip -UseBasicParsing
Expand-Archive $zip -DestinationPath $tmp -Force

$fontDir = "$env:LOCALAPPDATA\Microsoft\Windows\Fonts"
New-Item -ItemType Directory -Force $fontDir | Out-Null
Add-Type -AssemblyName PresentationCore
Get-ChildItem $tmp -Filter "JetBrainsMonoNerdFont-*.ttf" | ForEach-Object {
  $dest = Join-Path $fontDir $_.Name
  Copy-Item $_.FullName $dest -Force
  $gtf = New-Object System.Windows.Media.GlyphTypeface([uri]$dest)
  $name = "$($gtf.Win32FamilyNames['en-US']) $($gtf.Win32FaceNames['en-US']) (TrueType)"
  New-ItemProperty $regKey -Name $name -Value $dest -PropertyType String -Force | Out-Null
}
Remove-Item $zip, $tmp -Recurse -Force
Write-Host "JetBrainsMono Nerd Font installed. Restart Windows Terminal to use it."
{{ end -}}
