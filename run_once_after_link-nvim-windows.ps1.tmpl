{{ if eq .chezmoi.os "windows" -}}
# nvim on Windows reads %LOCALAPPDATA%\nvim; point it to ~/.config/nvim with a directory junction
$link = "$env:LOCALAPPDATA\nvim"
$target = "$env:USERPROFILE\.config\nvim"
if (Test-Path $link) {
  $item = Get-Item $link -Force
  if ($item.LinkType -ne "Junction") {
    Write-Warning "$link exists and is not a junction; back it up/remove it, then run chezmoi apply again"
    exit 1
  }
} else {
  New-Item -ItemType Junction -Path $link -Target $target | Out-Null
}
{{ end -}}
