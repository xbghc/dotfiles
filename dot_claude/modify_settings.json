{{- /* chezmoi:modify-template */ -}}
{{- /*
  Only the shared keys below are set; everything else in settings.json (model, effort, state written by Claude Code at runtime, etc.) is left as-is on each machine.
*/ -}}
{{- $s := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $s = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- $s = $s | setValueAtPath "$schema" "https://json.schemastore.org/claude-code-settings.json" -}}
{{- $s = $s | setValueAtPath "theme" "custom:catppuccin-latte" -}}
{{- $s = $s | setValueAtPath "language" "Chinese" -}}
{{- $s = $s | setValueAtPath "statusLine.type" "command" -}}
{{- $s = $s | setValueAtPath "statusLine.command" (printf "node \"%s\"" (joinPath .chezmoi.homeDir ".claude" "statusline.js")) -}}
{{- $s | toPrettyJson "  " -}}
