{{ if eq .chezmoi.os "windows" -}}
# Install the VSCode extensions listed in .chezmoidata/vscode.toml whenever the list changes
# If VSCode is installed later: chezmoi state delete-bucket --bucket=scriptState && chezmoi apply
if (-not (Get-Command code -ErrorAction SilentlyContinue)) {
  Write-Host "VSCode CLI (code) not found; skipping extensions"
  exit 0
}
$wanted = @(
{{- range .vscode.extensions }}
  {{ . | quote }}
{{- end }}
)
$installed = @(code --list-extensions)
$failed = $false
foreach ($ext in $wanted) {
  if ($ext -in $installed) { continue }  # -in is case-insensitive, like extension ids
  code --install-extension $ext
  if ($LASTEXITCODE -ne 0) { $failed = $true }
}
# a failure makes chezmoi run the script again on the next apply
if ($failed) { exit 1 }
{{ end -}}
